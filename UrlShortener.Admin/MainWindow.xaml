<Window x:Class="UrlShortener.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UrlShortener.Admin.ViewModels"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Сервис коротких ссылок — админка" Height="660" Width="980"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" FontSize="13"
        Icon="/Resources/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="22,16">
            <StackPanel>
                <TextBlock Text="Сервис коротких безопасных ссылок" Foreground="White"
                           FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Панель администратора" Foreground="#D6D9F5" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16" SelectedIndex="{Binding SelectedTab}">

            <TabItem Header="Создать ссылку">
                <Grid Margin="24" DataContext="{Binding Create}" MaxWidth="640" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="Новая ссылка" />

                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="GUID заказа" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding OrderId, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Сгенерировать" Command="{Binding NewGuidCommand}"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Срок жизни (дней)" />
                    <TextBox Grid.Row="4" Text="{Binding TtlDays, UpdateSourceTrigger=PropertyChanged}"
                             Width="130" HorizontalAlignment="Left" />

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
                        <CheckBox Content="Одноразовая" IsChecked="{Binding IsOneTime}" />
                        <CheckBox Content="HMAC-подпись" IsChecked="{Binding UseHmac}" Margin="24,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Создать ссылку" Command="{Binding CreateCommand}" Padding="22,9" />
                        <TextBlock Text="Выполняется…" Margin="14,0,0,0" Foreground="{StaticResource TextSecondary}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Border Grid.Row="7" Margin="0,20,0,0" Padding="16" Background="{StaticResource SuccessBg}"
                            BorderBrush="{StaticResource SuccessBorder}" BorderThickness="1" CornerRadius="10"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="✓ Ссылка создана" FontWeight="SemiBold"
                                       Foreground="{StaticResource Success}" FontSize="14" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Result.ShortUrl, Mode=OneWay}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Копировать" Command="{Binding CopyCommand}"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}">
                                <Run Text="Код:" />
                                <Run Text="{Binding Result.Code, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="     Истекает:" />
                                <Run Text="{Binding Result.ExpiresAt, Mode=OneWay, StringFormat='dd.MM.yyyy HH:mm'}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="7" Style="{StaticResource Error}" Text="{Binding Error}"
                               VerticalAlignment="Bottom"
                               Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />
                </Grid>
            </TabItem>

            <TabItem Header="Список ссылок">
                <DockPanel Margin="24">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Все ссылки" />
                    <DockPanel DataContext="{Binding List}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Обновить" Command="{Binding RefreshCommand}" />
                            <Button Content="Статистика выбранной" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding DataContext.OpenStatsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Деактивировать" Command="{Binding DeactivateCommand}"
                                    Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Error}" Style="{StaticResource Error}" Margin="14,0,0,0" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Links}" SelectedItem="{Binding Selected}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="GUID заказа" Binding="{Binding OrderId}" Width="240" />
                                <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="130" />
                                <DataGridTextColumn Header="Истекает" Binding="{Binding ExpiresAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="130" />
                                <DataGridTextColumn Header="Переходов" Binding="{Binding VisitCount}" Width="90" />
                                <DataGridTextColumn Header="Одноразовая" Binding="{Binding IsOneTime}" Width="100" />
                                <DataGridTextColumn Header="Активна" Binding="{Binding IsActive}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <TabItem Header="Статистика">
                <DockPanel Margin="24">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Статистика переходов" />
                    <DockPanel DataContext="{Binding Stats}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Код ссылки:" Margin="0,0,8,0" />
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                            <Button Content="Показать" Command="{Binding LoadCommand}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Error}" Style="{StaticResource Error}" Margin="14,0,0,0" />
                        </StackPanel>

                        <Grid Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Style="{StaticResource Card}" Background="{StaticResource PrimaryLight}"
                                        BorderBrush="{StaticResource PrimaryLight}" Padding="22,14" Margin="0,0,14,0">
                                    <StackPanel>
                                        <TextBlock Text="Всего переходов" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Stats.TotalVisits}" FontSize="28" FontWeight="Bold"
                                                   Foreground="{StaticResource Primary}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Background="{StaticResource PrimaryLight}"
                                        BorderBrush="{StaticResource PrimaryLight}" Padding="22,14">
                                    <StackPanel>
                                        <TextBlock Text="Уникальных IP" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Stats.UniqueVisitors}" FontSize="28" FontWeight="Bold"
                                                   Foreground="{StaticResource Primary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <DockPanel Grid.Row="1">
                                <TextBlock DockPanel.Dock="Top" Text="Переходы по дням" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding ByDay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat='dd.MM.yyyy'}"
                                                           Foreground="{StaticResource TextSecondary}" />
                                                <ProgressBar Grid.Column="1" Minimum="0" Value="{Binding Count, Mode=OneWay}"
                                                             Maximum="{Binding DataContext.MaxDayCount, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" Margin="6,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <TabItem Header="Журнал аудита">
                <DockPanel Margin="24">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Журнал действий" />
                    <DockPanel DataContext="{Binding Audit}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="С даты:" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding From}" Width="130" />
                            <TextBlock Text="По дату:" Margin="14,0,6,0" />
                            <DatePicker SelectedDate="{Binding To}" Width="130" />
                            <TextBlock Text="Действие:" Margin="14,0,6,0" />
                            <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" Width="150" />
                            <Button Content="Применить" Command="{Binding RefreshCommand}" Margin="14,0,0,0" />
                            <Button Content="Сбросить" Command="{Binding ResetCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Error}" Style="{StaticResource Error}" Margin="14,0,0,0" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата/время" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="160" />
                                <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="140" />
                                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Инициатор" Binding="{Binding Initiator}" Width="130" />
                                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
