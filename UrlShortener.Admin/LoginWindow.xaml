<Window x:Class="UrlShortener.Admin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора — вход"
        MinWidth="400" MinHeight="260"
        Width="480" Height="330"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" FontSize="13"
        Icon="/Resources/icon.ico">

	<Grid Margin="18">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="22,16" CornerRadius="8">
			<StackPanel>
				<TextBlock Text="Панель администратора"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold" />
				<TextBlock Text="Вход в систему"
                           Foreground="#D6D9F5"
                           FontSize="13"
                           Margin="0,2,0,0" />
			</StackPanel>
		</Border>

		<StackPanel Grid.Row="1" Margin="0,16,0,0">
			<TextBlock Text="Секрет администратора"
                       Style="{StaticResource FieldLabel}"
                       Margin="0,0,0,8" />
			<PasswordBox x:Name="SecretBox"
                         Width="360"
                         HorizontalAlignment="Left"
                         FontSize="14"
                         Padding="9,0"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource Surface}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource Border}"
                         BorderThickness="1"
                         CaretBrush="{StaticResource Primary}" />
		</StackPanel>

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
			<Button x:Name="OkButton"
                    Content="Войти"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="OkButton_Click"
                    IsDefault="True" />
			<Button Content="Отмена"
                    Width="100"
                    Click="CancelButton_Click"
                    Style="{StaticResource GhostButton}" />
		</StackPanel>

		<TextBlock x:Name="InfoText"
                   Grid.Row="3"
                   Style="{StaticResource Caption}"
                   Foreground="{StaticResource TextSecondary}"
                   FontSize="12"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Text="Введите секрет администратора (Auth:AdminSecret) для доступа к панели управления." />
	</Grid>
</Window>